{
  "version": 2,
  "headers": [
    {
      "source": "/widget.html",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/widget.html",
      "destination": "/widget.html?country=:x-vercel-ip-country&city=:x-vercel-ip-city"
    }
  ]
}
